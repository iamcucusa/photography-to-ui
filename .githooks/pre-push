#!/bin/sh
# Disclosure check on every outgoing commit message, at the last moment before
# publication.
#
# This is the backstop, and it is the one that matters. It scans the whole
# outgoing range, so it also catches commits authored before the hooks were
# installed, or made with --no-verify. Unpushed commits are free to reword;
# published ones cost a history rewrite.
#
# Opt-in per clone (core.hooksPath is local config, it does not travel):
#   git config core.hooksPath .githooks
#
# See CLAUDE.md -> Disclosure rules.

ROOT=$(git rev-parse --show-toplevel)
CHECK="$ROOT/scripts/check-disclosure.mjs"
ZERO=0000000000000000000000000000000000000000
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  # Deleting a remote ref pushes no commits.
  [ "$local_sha" = "$ZERO" ] && continue

  if [ "$remote_sha" = "$ZERO" ]; then
    # New branch: everything not already on some remote.
    range=$(git rev-list "$local_sha" --not --remotes)
  else
    range=$(git rev-list "$remote_sha..$local_sha")
  fi

  for sha in $range; do
    tmp=$(mktemp)
    git log -1 --format=%B "$sha" >"$tmp"
    if ! node "$CHECK" --commit-msg "$tmp" --raw >/dev/null 2>&1; then
      # This echoes the offending subject line, unlike the checker itself, which
      # never prints a match. Safe here and necessary: pre-push output goes to
      # the developer's own terminal, never to a CI log, and you cannot reword a
      # commit you cannot identify.
      echo ""
      echo "Disclosure check failed on commit $(git log -1 --format='%h %s' "$sha")"
      node "$CHECK" --commit-msg "$tmp" --raw 2>&1 | sed -n 's/^    (commit message)/    message line/p'
      status=1
    fi
    rm -f "$tmp"
  done
done

if [ "$status" -ne 0 ]; then
  echo ""
  echo "Push blocked. Reword the commits above before publishing:"
  echo "    git rebase -i <base>    (reword each flagged commit)"
  echo ""
  echo "These commits are not published yet, so rewording is free."
  echo "See CLAUDE.md -> Disclosure rules."
fi

exit $status
